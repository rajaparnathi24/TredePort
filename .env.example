# Optional: Public Google OAuth 2.0 Web Client ID for standalone deployment
# (When using Google Sheets outside of Firebase Auth provisioning)
# Note: Never place client secrets or private API keys in frontend VITE_* variables.
VITE_GOOGLE_CLIENT_ID=

# Server-side Permanent Google Sheets Sync (Service Account JSON - raw or Base64)
# Paste the full JSON string (or Base64) of your Google Cloud Service Account key here (never commit real secrets).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON (easier in Vercel Environment Variables):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=1SjefF9r_dWTfn27jT6RB5YerX1rmLkNzd3ZbP7PDzxA
GOOGLE_SHEET_GID=257632183

